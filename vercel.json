{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix momentum-ui install",
  "buildCommand": "npm --prefix momentum-ui run build:vercel",
  "outputDirectory": "momentum-ui/dist",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/web_dist/(.*)\\.wasm",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}